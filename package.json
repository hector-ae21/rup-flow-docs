{
  "name": "rup-flow-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Development and verification tools for the rup-flow documentation site",
  "license": "MIT",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.venv\" \"#site\"",
    "lint:spelling": "cspell --no-progress --show-suggestions \"**/*.{md,yml,yaml,json,toml,mjs,css,puml,iuml}\"",
    "render:diagrams": "node scripts/render-diagrams.mjs",
    "validate:diagrams": "node scripts/render-diagrams.mjs --check",
    "validate:secrets": "node scripts/scan-secrets.mjs",
    "build": "node scripts/build.mjs",
    "validate:html": "html-validate \"site/**/*.html\"",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:privacy": "node scripts/validate-privacy.mjs",
    "validate:a11y": "node scripts/validate-a11y.mjs",
    "test:release": "node --test test/*.test.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "cspell": "10.3.5",
    "html-validate": "11.16.1",
    "http-server": "14.1.1",
    "markdownlint-cli2": "0.23.3",
    "playwright": "1.63.0"
  },
  "rupFlow": {
    "version": "0.4.0"
  }
}
