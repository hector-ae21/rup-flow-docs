@startuml system-context
!include _theme.iuml
left to right direction

actor "Developer or analyst" as Person
rectangle "AI coding agent\nClaude Code, Claude on the web, Codex, Gemini CLI" as Agent

rectangle "rup-flow skill" as Skill {
  rectangle "SKILL.md and references\nRules and methodology, loaded on demand" as Rules
  rectangle "CLI (rup.mjs)\ninit, new use-case, index, render, check" as CLI
  rectangle "Templates and editions catalogue" as Templates
}

database "The documentation folder and\nthe configuration file" as Files
rectangle "PlantUML server\nLocal Docker container, 127.0.0.1" as PlantUML

Person --> Agent : prompt
Agent --> Rules : reads
Agent --> CLI : runs
CLI --> Templates : fills
CLI --> Files : reads and writes
CLI --> PlantUML : diagram sources
PlantUML --> CLI : SVG
Agent --> Files : writes documents
Agent --> Person : report: created, open questions, unchecked
@enduml
