@startuml editions-overlay
!include _theme.iuml
left to right direction

package "rup-flow (free, public, MIT)" as Free {
  rectangle "SKILL.md, references, templates\nFree workflow" as FreeSkill
  rectangle "CLI\nLoads an extension when present" as FreeCli
  rectangle "editions.json\nCatalogue" as Catalogue
}

package "Pro overlay (private)" as Pro {
  rectangle "scripts/pro\nThemes, Mermaid, explorer, scan" as Extension
  rectangle "Templates and references\nThe full workflow" as ProTemplates
  rectangle "Packs, domain libraries\nand subagents" as Extras
}

rectangle "rup-flow-pro package\nOne skill, both sets" as Package

FreeSkill --> Package : copied
FreeCli --> Package : copied
Catalogue --> Package : copied
Extension --> Package : laid over
ProTemplates --> Package : laid over
Extras --> Package : added
Package ..> FreeCli : scripts/pro/index.mjs found:\nPro behaviour

note bottom of Free
  Without the extension the same CLI
  runs as the free edition.
end note
@enduml
